  classDef core fill:#ecfdf5,stroke:#10b981,color:#052e1b
  classDef contract fill:#f5f3ff,stroke:#8b5cf6,color:#24103f
  classDef provider fill:#faf5ff,stroke:#a855f7,color:#3b0764
  classDef storage fill:#f1f5f9,stroke:#64748b,color:#111827

  class TITLE title
