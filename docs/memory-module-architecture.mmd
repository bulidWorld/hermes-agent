flowchart LR
  TITLE["MemoryManager 实现图<br/><span style='font-size:13px'>把 Agent 的记忆相关事件统一转成 provider 调用，并隔离 provider 失败。</span>"]

  LEGEND["颜色图例<br/>蓝=启动注册<br/>绿=每轮召回/写入<br/>紫=工具路由<br/>橙=生命周期事件<br/>灰虚线=配置/存储依赖"]

  subgraph CALLERS["调用方"]
    direction TB
    C_INIT["agent_init.py<br/>创建 manager，加载 active provider。"]
    C_LOOP["conversation_loop.py<br/>每轮调用 prefetch / sync / queue。"]
    C_TOOL["tool_executor.py<br/>memory tool 统一交给 manager。"]
    C_LIFE["compression / runtime / shutdown<br/>压缩、内置写入镜像、会话结束。"]
  end

  subgraph API["MemoryManager 对外 API"]
    direction TB
    A_BOOT["启动注册 API<br/>add_provider、initialize_all、build_system_prompt。"]
    A_TURN["每轮读写 API<br/>on_turn_start、prefetch_all、sync_all、queue_prefetch_all。"]
    A_TOOL["工具路由 API<br/>get_all_tool_schemas、has_tool、handle_tool_call。"]
    A_LIFE["生命周期 API<br/>on_session_switch、on_pre_compress、on_session_end、shutdown_all。"]
    A_MIRROR["镜像 / 委派 API<br/>on_memory_write、on_delegation。"]
  end

  subgraph CORE["MemoryManager 内部机制"]
    direction TB
    I_STATE["状态表<br/>_providers 保存注册顺序；_has_external 限制一个外部 provider。"]
    I_ROUTER["工具路由表<br/>_tool_to_provider 把工具名映射到具体 provider。"]
    I_FANOUT["Provider fan-out<br/>按 provider 顺序调用；空结果跳过，多个结果合并。"]
    I_GUARD["防护与容错<br/>try/catch 隔离单个 provider；sanitize / scrubber 清理 memory-context。"]
  end

  subgraph CONTRACT["MemoryProvider 合约"]
    direction TB
    P_CORE["核心方法<br/>initialize、system_prompt_block、prefetch、queue_prefetch、sync_turn、shutdown。"]
    P_TOOLS["工具方法<br/>get_tool_schemas、handle_tool_call。"]
    P_HOOKS["Hook 方法<br/>on_turn_start、on_session_switch、on_pre_compress、on_memory_write、on_delegation。"]
  end

  subgraph PROVIDERS["Provider 实例"]
    direction TB
    PR_BUILTIN["builtin provider<br/>内置长期记忆能力。"]
    PR_EXTERNAL["external provider<br/>Honcho / Mem0 / Supermemory / Hindsight 等，最多一个。"]
  end

  subgraph STORAGE["配置与存储"]
    direction TB
    D_CONFIG["config.yaml / .env<br/>memory.provider 与 provider 凭据。"]
    D_STATE["state.db<br/>会话 transcript，供压缩和结束边界使用。"]
    D_BACKEND["provider 后端<br/>本地文件、SaaS API、向量库或插件私有存储。"]
  end

  TITLE --> C_INIT
  TITLE --> LEGEND

  C_INIT --> A_BOOT --> I_STATE --> P_CORE
  C_LOOP --> A_TURN --> I_FANOUT --> P_CORE
  C_TOOL --> A_TOOL --> I_ROUTER --> P_TOOLS
  C_LIFE --> A_LIFE --> P_HOOKS
  C_LIFE --> A_MIRROR --> P_HOOKS

  A_TURN --> I_GUARD
  A_TOOL --> I_GUARD
  A_LIFE --> I_GUARD

  P_CORE --> PR_BUILTIN
  P_CORE --> PR_EXTERNAL
  P_TOOLS --> PR_BUILTIN
  P_TOOLS --> PR_EXTERNAL
  P_HOOKS --> PR_EXTERNAL

  PR_BUILTIN --> D_BACKEND
  PR_EXTERNAL --> D_BACKEND
  C_INIT -. reads .-> D_CONFIG
  C_LIFE -. reads transcript .-> D_STATE
  PR_EXTERNAL -. optional .-> D_STATE

  classDef title fill:#111827,stroke:#111827,color:#ffffff
  classDef legend fill:#f8fafc,stroke:#cbd5e1,color:#334155
  classDef caller fill:#eff6ff,stroke:#60a5fa,color:#0f172a
