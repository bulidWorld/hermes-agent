flowchart LR
  TITLE["工具模块逻辑图<br/><span style='font-size:13px'>注册、暴露、调用、回灌与恢复保护的整体关系。</span>"]
  LEGEND["蓝=注册发现　青=Schema 暴露　绿=执行主链　紫=扩展/桥接　橙=恢复保护　灰虚线=配置/存储依赖"]

  subgraph LEFT["注册与暴露"]
    direction TB
    SRC["工具来源<br/>内置 tools/*.py、插件 ctx.register_tool、MCP 动态工具"]
    REG["ToolRegistry<br/>ToolEntry 元数据、shadow 防护、override、generation"]
    SETS["toolsets.py<br/>核心 / 场景 / 组合 / 插件 toolset"]
    DEFS["get_tool_definitions<br/>过滤 enabled/disabled，动态 schema，sanitize"]
  end

  subgraph MID["调用执行主链"]
    direction TB
    INIT["AIAgent 初始化<br/>self.tools、valid_tool_names"]
    LLM["LLM tool_calls<br/>assistant_message.tool_calls"]
    BATCH["批处理执行<br/>去重、并发判断、读写冲突检查"]
    ROUTE["调用调度<br/>解析 args、repair 名称、Agent 级工具或 registry.dispatch"]
    RESULT["结果回灌<br/>预算限制、tool_call_id 匹配、追加 tool message"]
  end

  subgraph RIGHT["恢复、保护与后端"]
    direction TB
    BRIDGE["Tool Search bridge<br/>tool_call 解包，校验会话范围"]
    HOOKS["插件与防护<br/>pre_tool_call、审批、guardrails、post/transform"]
    RECOVER["恢复与协议修复<br/>/resume、状态水合、孤儿 tool result 清理"]
    CHECKPOINT["文件系统 checkpoint<br/>write_file / patch / 破坏性 terminal 前快照"]
    STORE["配置与存储<br/>config.yaml、SessionDB、JSON log、工具后端"]
  end

  TITLE --> LEGEND
  TITLE --> SRC

  SRC --> REG --> SETS --> DEFS --> INIT
  INIT --> LLM --> BATCH --> ROUTE --> RESULT --> LLM

  ROUTE --> BRIDGE --> ROUTE
  ROUTE --> HOOKS --> RESULT
  RESULT --> STORE

  RECOVER --> INIT
  CHECKPOINT --> HOOKS

  STORE -. config .-> SRC
  STORE -. config .-> DEFS
  STORE -. history .-> RECOVER
  STORE -. backend .-> ROUTE
  STORE -. snapshots .-> CHECKPOINT

  classDef title fill:#111827,stroke:#111827,color:#ffffff
  classDef legend fill:#f8fafc,stroke:#cbd5e1,color:#334155
  classDef source fill:#eff6ff,stroke:#3b82f6,color:#0f172a
  classDef registry fill:#dbeafe,stroke:#2563eb,color:#172554
  classDef exposure fill:#ecfeff,stroke:#06b6d4,color:#083344
  classDef agent fill:#ecfdf5,stroke:#10b981,color:#052e1b
  classDef dispatch fill:#f0fdf4,stroke:#22c55e,color:#052e16
  classDef result fill:#fff7ed,stroke:#f97316,color:#431407
  classDef ext fill:#f5f3ff,stroke:#8b5cf6,color:#24103f
  classDef recovery fill:#fffbeb,stroke:#f59e0b,color:#451a03
  classDef state fill:#f1f5f9,stroke:#64748b,color:#111827

  class TITLE title
  class LEGEND legend
  class SRC source
  class REG registry
  class SETS,DEFS exposure
  class INIT,LLM,BATCH agent
  class ROUTE dispatch
  class RESULT result
  class BRIDGE,HOOKS ext
  class RECOVER,CHECKPOINT recovery
  class STORE state

