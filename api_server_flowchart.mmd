flowchart TB
    subgraph Startup["🚀 启动与生命周期"]
        A["connect() - 启动 aiohttp 服务器"] --> B["端口冲突检测 (127.0.0.1:port)"]
        B -->|端口空闲| C["注册所有路由 (30+ 端点)"]
        B -->|端口占用| FAIL1["返回 False"]
        C --> D["注册自定义扩展路由 (custom_extension)"]
        D --> E["启动孤儿 Run 清理任务 (_sweep_orphaned_runs)"]
        E --> F["API_SERVER_KEY 检查"]
        F -->|未设置| REFUSE1["拒绝启动: 需要 API key"]
        F -->|已设置| G["网络可达性检查 (非 loopback + weak key)"]
        G -->|弱密钥+公网| REFUSE2["拒绝启动: 需要强密钥"]
        G -->|通过| H["web.TCPSite 启动, 监听 host:port"]
    end

    subgraph Middleware["🔗 中间件链 (按顺序执行)"]
        M1["cors_middleware - CORS 来源校验 + OPTIONS 预检"] --> M2["body_limit_middleware - 请求体大小限制 10MB"]
        M2 --> M3["security_headers_middleware - CSP/HSTS/X-Frame-Options 等"]
    end

    subgraph Auth["🔐 认证 (_check_auth)"]
        AUTH1["提取 Authorization: Bearer <token>"] --> AUTH2["hmac.compare_digest() 比对"]
        AUTH2 -->|匹配| AUTH_OK["通过"]
        AUTH2 -->|不匹配| AUTH_401["401 Invalid API key"]
    end

    subgraph Health["❤️ 健康检查 (无需认证)"]
        H1["GET /health → _handle_health"] --> H1R["{ status: 'ok', platform: 'hermes-agent' }"]
        H2["GET /health/detailed → _handle_health_detailed"] --> H2R["{ gateway_state, platforms, active_agents, pid }"]
    end

    subgraph Discovery["📋 发现端点"]
        D1["GET /v1/models → _handle_models"] --> D1R["返回 hermes-agent 模型列表"]
        D2["GET /v1/capabilities → _handle_capabilities"] --> D2R["返回功能矩阵 + 端点列表"]
        D3["GET /v1/skills → _handle_skills"] --> D3R["返回已安装 Skill 列表"]
        D4["GET /v1/toolsets → _handle_toolsets"] --> D4R["返回 Toolset 及对应工具列表"]
    end

    subgraph ChatCompletions["💬 POST /v1/chat/completions (OpenAI 兼容)"]
        direction TB
        CC1["解析 messages 数组\n提取 system prompt + user/assistant 消息"] --> CC2["_normalize_multimodal_content()\n验证文本+图片, 拒绝文件类型"]
        CC2 -->|验证失败| CC400["400 error"]
        CC2 -->|通过| CC3["解析请求头:\nX-Hermes-Session-Id (会话连续性)\nX-Hermes-Session-Key (长期记忆作用域)"]
        CC3 --> CC4{"stream = true ?"}
        CC4 -->|是| CC_S["流式 SSE 分支"]
        CC4 -->|否| CC_B["同步分支"]

        CC_S --> CCS1["创建 _stream_q 队列\n设置回调: _on_delta,\n_on_tool_start, _on_tool_complete"]
        CCS1 --> CCS2["asyncio.ensure_future\n后台运行 _run_agent()"]
        CCS2 --> CCS3["_write_sse_chat_completion()\nSSE 事件循环"]
        CCS3 --> CCS4["SSE 事件序列:\n1. role chunk\n2. delta content chunks\n3. hermes.tool.progress 事件\n4. finish chunk + [DONE]"]
        CCS4 --> CCS5["客户端断开时:\nagent.interrupt() + task.cancel()"]

        CC_B --> CCB1["支持 Idempotency-Key 幂等缓存"]
        CCB1 --> CCB2["_run_agent() 同步执行"]
        CCB2 --> CCB3["构建 OpenAI 格式响应:\nid / object / choices / usage"]
        CCB3 --> CCB4["处理 partial/failed:\nfinish_reason = length|error|stop\n附加 hermes 扩展字段"]
    end

    subgraph Responses["📨 POST /v1/responses (OpenAI Responses API)"]
        direction TB
        R1["解析 input/instructions/\nprevious_response_id/conversation"] --> R2["从 ResponseStore 恢复历史\n或使用请求中的 conversation_history"]
        R2 --> R3["_normalize_multimodal_content()\n注入文件附件"]
        R3 --> R4{"stream = true ?"}
        R4 -->|是| R_S["Responses SSE 流"]
        R4 -->|否| R_B["同步 Responses"]

        R_S --> RS1["_write_sse_responses()"]
        RS1 --> RS2["SSE 事件序列:\n1. response.created (in_progress)\n2. response.output_item.added (message)\n3. response.output_text.delta\n4. response.output_item.added (function_call)\n5. response.output_item.done (function_call)\n6. response.output_item.added (function_call_output)\n7. response.output_text.done\n8. response.output_item.done (message)"]
        RS2 --> RS3["终端事件:\n成功 → response.completed\n失败 → response.failed"]
        RS3 --> RS4["store=true 时存入 ResponseStore\n支持 previous_response_id 链式调用"]

        R_B --> RB1["_run_agent() 同步执行"]
        RB1 --> RB2["_extract_output_items():\n解析 function_call +\nfunction_call_output +\nassistant message"]
        RB2 --> RB3["构建完整响应对象\n存入 ResponseStore (store=true)"]
    end

    subgraph ResponseStore["🗄️ ResponseStore (SQLite LRU 持久化)"]
        RS_DB["response_store.db\n(WAL 模式, 权限 0o600)"] --> RS_T1["responses 表:\nresponse_id | data | accessed_at"]
        RS_DB --> RS_T2["conversations 表:\nname → response_id 映射"]
        RS_DB --> RS_EVICT["LRU 淘汰策略:\n超过 MAX(100) 时删除最旧条目"]
    end

    subgraph Sessions["📂 /api/sessions 会话管理"]
        direction LR
        S1["GET /api/sessions\n列表 (分页)"] --> S2["POST /api/sessions\n创建空会话"]
        S2 --> S3["GET /api/sessions/{id}\n获取详情"]
        S3 --> S4["PATCH /api/sessions/{id}\n更新 title/end_reason"]
        S4 --> S5["DELETE /api/sessions/{id}\n删除会话"]
        S5 --> S6["GET .../{id}/messages\n消息历史"]
        S6 --> S7["POST .../{id}/fork\n分支会话 (lineage)"]
        S7 --> S8["POST .../{id}/chat\n同步对话"]
        S8 --> S9["POST .../{id}/chat/stream\nSSE 流式对话"]
    end

    subgraph Runs["🏃 /v1/runs 异步运行 (结构化事件流)"]
        direction TB
        RUN1["POST /v1/runs → _handle_runs"] --> RUN2{"并发限制 MAX=10 ?"}
        RUN2 -->|超限| RUN429["429 rate_limit_exceeded"]
        RUN2 -->|通过| RUN3["创建 run_id + asyncio.Queue\n后台 asyncio.Task 执行"]
        RUN3 --> RUN4["状态流转:\nqueued → running\n→ waiting_for_approval\n→ completed / failed / cancelled"]
        RUN4 --> RUN5["GET /v1/runs/{id}\n轮询当前状态"]
        RUN5 --> RUN6["GET /v1/runs/{id}/events\nSSE 生命周期事件流"]
        RUN6 --> RUN7["POST .../{id}/approval\n解析审批 (once/session/always/deny)"]
        RUN7 --> RUN8["POST .../{id}/stop\nagent.interrupt() + task.cancel()"]
        RUN8 --> RUN9["_sweep_orphaned_runs()\n每60秒清理 TTL=300s 的孤儿流"]
    end

    subgraph Jobs["⏰ /api/jobs Cron 任务管理"]
        direction LR
        J1["GET /api/jobs 列表"] --> J2["POST /api/jobs 创建"]
        J2 --> J3["GET /api/jobs/{id} 详情"]
        J3 --> J4["PATCH /api/jobs/{id} 更新"]
        J4 --> J5["DELETE /api/jobs/{id} 删除"]
        J5 --> J6["POST .../{id}/pause 暂停"]
        J6 --> J7["POST .../{id}/resume 恢复"]
        J7 --> J8["POST .../{id}/run 立即触发"]
    end

    subgraph AgentCore["🤖 Agent 执行核心 (_run_agent)"]
        direction TB
        AC1["在 ThreadPoolExecutor 中运行"] --> AC2["_create_agent() 实例化 AIAgent"]
        AC2 --> AC3["参数组装:\n• model (gateway 配置)\n• enabled_toolsets (api_server)\n• session_db (state.db)\n• fallback_model\n• gateway_session_key\n• 回调: delta/tool_start/tool_complete"]
        AC3 --> AC4["agent.run_conversation()\nuser_message + conversation_history"]
        AC4 --> AC5["返回 (result_dict, usage_dict):\n• final_response\n• messages (完整对话)\n• session_id\n• input/output/total_tokens"]
    end

    subgraph Extensions["🔌 自定义扩展 (ExtensionAggregator)"]
        direction LR
        EXT1["extend_capabilities()"] --> EXT2["extend_endpoints()"]
        EXT2 --> EXT3["register_routes()"]
        EXT3 --> EXT4["inject_attachments()\n(文件上传支持)"]
    end

    subgraph Shutdown["🛑 关闭 (disconnect)"]
        direction LR
        SD1["_site.stop()"] --> SD2["_runner.cleanup()"]
        SD2 --> SD3["_custom_extension.close()"]
        SD3 --> SD4["_app = None"]
    end

    %% 跨模块关键连接
    Health --> Middleware
    Middleware --> Auth
    Auth --> Discovery
    Auth --> ChatCompletions
    Auth --> Responses
    Auth --> Sessions
    Auth --> Runs
    Auth --> Jobs
    ChatCompletions --> AgentCore
    Responses --> AgentCore
    Responses --> ResponseStore
    Sessions --> AgentCore
    Runs --> AgentCore

